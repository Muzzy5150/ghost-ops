# Optional. Defaults work with no environment file and no external services.
DATABASE_URL="file:./prisma/ghostops.db"
PORT=3000
# Optional persistent integrity key, at least 32 characters. Do not commit real values.
# If unset, generated automatically in .ghostops/integrity.key (mode 0600).
# GHOSTOPS_SIGNING_SECRET="replace-with-your-own-random-secret"

# Optional isolated local client. Scripts do not automatically load .env.
# GHOSTOPS_URL="http://127.0.0.1:3210"
# GHOSTOPS_CLIENT_DIR="/absolute/private/test-client-directory"
# GHOSTOPS_RUNTIME_WORKSPACE="/absolute/private/restricted-summary-workspace"
# Real inference needs explicit enablement, approved model and credentials.
# Also opt in via agent:run -- --model --live and interactive confirmation,
# OR Security Lab cost consent, dry preflight and fresh exact-run confirmation.
# Disabled by default; use synthetic inputs only. Costs/provider retention apply.
# GHOSTOPS_MODEL_ENABLED=1
# GHOSTOPS_MODEL_PROVIDER="openai"
# GHOSTOPS_MODEL="your-approved-model-id"
# OPENAI_API_KEY="set-securely-in-your-shell-never-commit"
# Security Lab also requires explicit per-run model-cost consent in its UI/API.
# GHOSTOPS_RUN_MODEL_SMOKE=1 # Still requires test:model -- --live and interactive confirmation.

# Phase 11 optional integrations: ALL external transfers disabled by default.
# GHOSTOPS_SPONSOR_EGRESS=0
# GHOSTOPS_SEMGREP_BINARY=/absolute/approved/semgrep
# GHOSTOPS_SCAN_TARGET_ROOT=/absolute/operator-approved/synthetic-repository
# GHOSTOPS_CLICKHOUSE_ENABLED=0
# GHOSTOPS_CLICKHOUSE_URL=http://127.0.0.1:8123
# GHOSTOPS_CLICKHOUSE_APPROVED_ORIGIN=http://127.0.0.1:8123
# GHOSTOPS_CLICKHOUSE_USER=restricted_ghostops_user
# GHOSTOPS_CLICKHOUSE_PASSWORD=set-privately
# GHOSTOPS_MONGODB_ENABLED=0
# GHOSTOPS_MONGODB_URI=set-privately
# GHOSTOPS_MONGODB_APPROVED_HOST=127.0.0.1
# GHOSTOPS_SENSO_ENABLED=0
# SENSO_API_KEY=set-privately
# GHOSTOPS_SENSO_CONTENT_IDS=approved-synthetic-document-uuid
# GHOSTOPS_ELEVENLABS_ENABLED=0
# ELEVENLABS_API_KEY=set-privately
# GHOSTOPS_ELEVENLABS_VOICE=approved-voice-id
# GHOSTOPS_ELEVENLABS_MODEL=approved-model-id
# Local Responses-compatible model alternative; never auto-download a model:
# GHOSTOPS_MODEL_PROVIDER=local-responses
# GHOSTOPS_MODEL_BASE_URL=http://127.0.0.1:9999/v1
# GHOSTOPS_LOCAL_MODEL_KEY=set-privately
# GHOSTOPS_LOCAL_MODEL_ALLOW_NO_AUTH=0

# Phase 12 Web Sentinel: separate worktree and database; read-only public egress
# needs this switch AND exact per-run approval. Never reused as publishing approval.
# GHOSTOPS_WEB_ENABLED=0
# GHOSTOPS_MODEL_PROVIDER=ollama-local
# GHOSTOPS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# GHOSTOPS_MODEL=your-already-installed-local-model:latest
# GHOSTOPS_LOCAL_MODEL_ALLOW_NO_AUTH=1
# Only existing non-cloud models <=2 GiB supported; no automatic model download.
# External issue creation is disabled by default; exact target/content confirmation
# is mandatory even when these private operator settings are present.
# GHOSTOPS_GITHUB_PUBLISH_ENABLED=0
# GHOSTOPS_GITHUB_OWNER=your-authorized-owner
# GHOSTOPS_GITHUB_REPO=your-authorized-demonstration-repository
# GHOSTOPS_GITHUB_SCOPE=security-report
# GHOSTOPS_GITHUB_TOKEN=set-privately-not-in-chat-or-source-control
# Hosting: apps/website is a standalone STATIC, READ-ONLY export.
# It needs no backend URL, database, key, model token or GitHub publisher token.
# Never copy this local runtime environment into Vercel.
